# 복사해서 .env.local 로 쓰세요.  .env.local 은 절대 커밋하지 말 것.
VITE_API_BASE_URL=https://r0swh7n17i.execute-api.ap-northeast-2.amazonaws.com

# 테넌트별 API 키 (Secrets Manager: cjone/tenant/api-keys)
#   export AWS_PROFILE=capstone-terraform
#   aws secretsmanager get-secret-value --region ap-northeast-2 \
#     --secret-id cjone/tenant/api-keys --query SecretString --output text
# ⚠️ 프론트 번들에 그대로 박히는 값이다. 시연용 로컬 환경에서만 쓰고 외부에 배포하지 말 것.
VITE_CGV_KEY=
VITE_CJENM_KEY=
VITE_OLIVEYOUNG_KEY=
VITE_VIPS_KEY=

# mock  = 에이전트 이벤트를 프론트에서 만들어 재생 (지금 기본값)
# live  = 실제 에이전트 이벤트 API를 폴링 (VITE_AGENT_EVENTS_URL 필요)
VITE_AGENT_SOURCE=mock
VITE_AGENT_EVENTS_URL=
